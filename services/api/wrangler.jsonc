{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "siti-counter-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 4 * * *"]
  },
  // Social sign-in configuration. Secrets (FACEBOOK_APP_SECRET) belong in `wrangler secret put`,
  // not here; the public ids are safe to commit. A provider with no id answers 503
  // NOT_CONFIGURED rather than accepting an unverified token.
  "vars": {
    "APPLE_CLIENT_ID": "com.siticounter.app",
    "GOOGLE_CLIENT_ID": "",
    "FACEBOOK_APP_ID": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "siti-counter",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COOKING_SESSION",
        "class_name": "CookingSessionDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["CookingSessionDurableObject"]
    }
  ]
}