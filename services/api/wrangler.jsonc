{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "siti-counter-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 4 * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COOKING_SESSION",
        "class_name": "CookingSessionDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["CookingSessionDurableObject"]
    }
  ]
}
